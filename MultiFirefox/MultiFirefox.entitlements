<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Release builds are signed with a self-signed certificate, which has no Team ID.
	Under the hardened runtime, library validation only allows frameworks with the
	same Team ID, so the embedded Sparkle.framework would be rejected by dyld.
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
